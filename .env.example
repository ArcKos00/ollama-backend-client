# Шаблон змінних для docker compose.
# Скопіюй у .env і заповни РЕАЛЬНИМИ значеннями (.env у .gitignore, не комітиться):
#   cp .env.example .env
#
# Обов'язкові (compose впаде, якщо не задані): RABBITMQ_HOST, RABBITMQ_USER,
# RABBITMQ_PASSWORD, APM_SERVER_URL. Решта має дефолти в docker-compose.yaml.

# --- RabbitMQ (внутрішня інфраструктура) ---
RABBITMQ_HOST=rabbitmq.example.lan
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme
# Необов'язкові (дефолти в compose):
#RABBITMQ_PORT=5672
#RABBITMQ_VHOST=ollama
#RABBITMQ_REQUEST_QUEUE=ollama-requests
#RABBITMQ_PREFETCH=1

# --- Elastic APM ---
APM_SERVER_URL=https://apm.example.lan
# Необов'язкові:
#APM_SERVICE_NAME=ollama-backend-client
#APM_ENVIRONMENT=Production
#APM_SAMPLE_RATE=
#APM_ENABLED=true
#APM_GLOBAL_LABELS=group=LLM
#APM_VERIFY_CERT=false

# --- Ollama (спільне для клієнта і model-puller) ---
OLLAMA_MODEL=llama3:8b
# Необов'язкові:
#OLLAMA_BASE_URL=http://127.0.0.1:11434
#OLLAMA_TIMEOUT=00:05:00
