{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "RequestQueue": "ollama-requests",
    "PrefetchCount": 4
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "Model": "llama3:8b",
    "Timeout": "00:05:00"
  },
  "ElasticApm": {
    "ServiceName": "ollama-backend-client",
    "Environment": "production",
    "ServerUrl": "http://localhost:8200",
    "TransactionSampleRate": 1.0,
    "Enabled": true
  }
}
